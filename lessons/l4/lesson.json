        "title": "Pattern: ask a yes/no question with ma",
        "body_en": "You already know this from nǐ hǎo ma. Just add ma to the end of any statement.",
        "pairs": [
          {
            "en": "You have kids.",
            "py": "Nǐ yǒu háizi."
          },
          {
            "en": "Do you have kids?",
            "py": "Nǐ yǒu háizi ma?"
          }
        ]
      },
      {
        "type": "callout",
        "kind": "bonus",
        "title": "Bonus (recognize only): counting people",
        "body_en": "Chinese puts a little counter word (gè) between a number and a noun. No need to memorize yet.",
        "pairs": [
          {
            "en": "one (+ counter)",
            "py": "yí gè"
          },
          {
            "en": "two (+ counter)",
            "py": "liǎng gè"
          }
        ]
      },
      {
        "type": "heading",
