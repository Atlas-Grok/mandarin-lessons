{
  "lesson_number": 4,
  "title_en": "My Family",
  "title_py": "wǒ de jiā",
  "category": "Family / people",
  "hsk": 1,
  "teach": {
    "intro": {
      "en": "Hi Evan! Yesterday you met son (érzi), daughter (nǚ'ér), and home/family (jiā). Today we add three small, powerful words so you can actually talk about YOUR family: \"to have,\" \"child,\" and the little word that makes \"my.\""
    },
    "blocks": [
      {
        "type": "heading",
        "text": "New words"
      },
      {
        "type": "vocab_card",
        "en": "to have",
        "py": "yǒu",
        "note_en": "Super simple: it never changes. I have = wǒ yǒu. He/she has = tā yǒu."
      },
      {
        "type": "vocab_card",
        "en": "child / kids",
        "py": "háizi",
        "note_en": "Same word for one child or several. Context tells you which."
      },
      {
        "type": "vocab_card",
        "en": "'s / of (possessive)",
        "py": "de",
        "note_en": "Put it after a person to show ownership: my | wǒ de, your | nǐ de, his/her | tā de. Tip: with close family and home, Chinese often drops de: my mom | wǒ māma, my family | wǒ jiā."
      },
      {
        "type": "heading",
        "text": "Quick refresh"
      },
      {
