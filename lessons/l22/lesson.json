        "listen_url": "l22-ren.mp3"
      },
      {
        "type": "vocab_card",
        "en": "and",
        "py": "hé",
        "note_en": "Hé is 2nd tone. It joins two things: bàba hé māma.",
        "note_py": "Hé shì dì-èr shēng. Tā lián liǎng gè dōngxi: bàba hé māma.",
        "listen_url": "l22-he.mp3"
      },
