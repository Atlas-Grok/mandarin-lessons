      },
      {
        "type": "vocab_card",
        "en": "soup",
        "py": "tāng",
        "note_en": "Tāng is 1st tone, high and flat. Wǒ hē tāng = I drink soup.",
        "note_py": "Tāng shì dì-yī shēng. Wǒ hē tāng.",
        "listen_url": "l22-tang.mp3"
      },
      {
        "type": "vocab_card",
        "en": "vegetable / dish",
        "py": "cài",
